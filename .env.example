# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# GitHub Pages base path (default matches repo name)
# VITE_BASE=/shabbos-rsvp/

# Local/demo mode only — used when Supabase is not configured.
# Production admin password is set as ADMIN_PASSWORD on the Edge Function, not here.
VITE_DEMO_ADMIN_PASSWORD=shabbos-admin
