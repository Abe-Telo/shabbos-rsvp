# Shared API (OrderAssist-hosted SQLite DB) — preferred for live shared RSVPs
VITE_API_URL=https://keys.orderassistnow.com/shabbos-api

# Supabase (optional alternative)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# GitHub Pages base path (default matches repo name)
# VITE_BASE=/shabbos-rsvp/

# Local/demo mode only — used when no API/Supabase is configured.
VITE_DEMO_ADMIN_PASSWORD=shabbos-admin
